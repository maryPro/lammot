# Copy to .env for local runs. Never commit the real .env (it is in .gitignore).
# On Railway, set these in the service's Variables tab instead.

# Token from @BotFather — required, the app will not start without it.
# Treat it like a password. If it leaks: /revoke in BotFather.
BOT_TOKEN=

# Public HTTPS address of the app: the ngrok URL locally, the Railway domain in
# production. On startup the app points the bot's webhook and menu button here.
# Empty = no webhook (the API still works, /start does not answer).
PUBLIC_URL=

# SQLite file. On Railway: /data/lammot.db on the attached volume
# (the Docker image already defaults to that).
DATABASE_PATH=./lammot.db

# How long (seconds) Telegram initData stays valid
INIT_DATA_MAX_AGE=86400

LOG_LEVEL=INFO

# Optional. Comma-separated CORS origins; empty = PUBLIC_URL.
ALLOWED_ORIGINS=

# Optional. Only if YouTube blocks the server with "confirm you're not a bot":
# path to a cookies.txt exported from a separate throwaway Google account.
# This file is a login credential — never commit it.
YTDLP_COOKIES_FILE=

# Optional. Only if you created the Mini App with /newapp in BotFather:
# its short name, so share links look like t.me/<bot>/<short_name>?startapp=...
MINI_APP_SHORT_NAME=
