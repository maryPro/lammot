# Copy to .env for local runs. Never commit the real .env (it is in .gitignore).
# On Railway, set these in the service's Variables tab instead.

# Token from @BotFather — required, the app will not start without it
BOT_TOKEN=

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=https://lammot.up.railway.app

# How long (seconds) Telegram initData stays valid
INIT_DATA_MAX_AGE=86400

LOG_LEVEL=INFO
